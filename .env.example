# Copy to .env and set ONE key
ANTHROPIC_API_KEY=
# OPEN_AI_API_KEY=

# Optional
# LLM_PROVIDER=anthropic        # anthropic or openai, when both keys are set
# LLM_MODEL=claude-sonnet-5-5   # default: claude-sonnet-5-5 / gpt-5
# MONGO_URL=mongodb://127.0.0.1:27017/route_tracer
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# Web page (web/web.rb) only
# MONGODB_URI=mongodb://127.0.0.1:27017/route_tracer
# POSTMARK_API_TOKEN=          # emails for each scan action; POSTMARK_API_TEST checks requests without sending
# NOTIFY_EMAIL=                # default sella.rafaeli@gmail.com
# POSTMARK_FROM=               # a confirmed Postmark sender; default sella@indydevs.com
# GOOGLE_CLIENT_ID=             # with the secret: every page needs a Google sign-in
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=               # openssl rand -hex 32
# ALLOWED_DOMAINS=              # e.g. variablee.com; empty allows any Google account
# ALLOWED_EMAILS=
# ADMIN_EMAILS=                 # see every user's scans; default sella.rafaeli@gmail.com
